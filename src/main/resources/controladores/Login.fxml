<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controladores.LoginController">
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
   <children>
      <Label text="Sistema de Gestión de Turnos" textFill="#1a237e">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>
      
      <Label text="Iniciar Sesión" textFill="#333333">
         <font>
            <Font size="16.0" />
         </font>
      </Label>

      <VBox spacing="8.0" maxWidth="280.0">
         <children>
            <Label text="Usuario" />
            <TextField fx:id="txtUsuario" promptText="Ingrese su usuario" prefHeight="38.0" />
            
            <Label text="Contraseña" />
            <PasswordField fx:id="txtPassword" promptText="Ingrese su contraseña" prefHeight="38.0" />
         </children>
      </VBox>

      <Button fx:id="btnIngresar" mnemonicParsing="false" prefHeight="42.0" prefWidth="280.0" style="-fx-background-color: #1a237e; -fx-text-fill: white; -fx-font-weight: bold;" text="INGRESAR" />
      
      <Label fx:id="lblMensaje" text="" textFill="#c62828" />
   </children>
</VBox>