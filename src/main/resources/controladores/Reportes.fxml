<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="620.0" prefWidth="1100.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controladores.ReportesController">

   <top>
      <VBox spacing="12.0">
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="15.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label text="REPORTES" textFill="#1a237e">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblUsuario" text="Administrador" textFill="#616161" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnCerrarSesion" mnemonicParsing="false" text="Cerrar sesión" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="Desde:" />
                  <DatePicker fx:id="dpDesde" prefWidth="140.0" />
                  <Label text="Hasta:" />
                  <DatePicker fx:id="dpHasta" prefWidth="140.0" />
                  <Button fx:id="btnConsultar" mnemonicParsing="false" style="-fx-background-color: #1a237e; -fx-text-fill: white; -fx-font-weight: bold;" text="CONSULTAR" />
                  <Label fx:id="lblMensaje" textFill="#c62828" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>

   <center>
      <TabPane tabClosingPolicy="UNAVAILABLE">
         <tabs>
            <Tab text="Turnos atendidos y tiempos">
               <content>
                  <VBox spacing="10.0">
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="10.0" />
                     </padding>
                     <children>
                        <HBox spacing="30.0">
                           <children>
                              <Label fx:id="lblTotalAtendidos" text="Atendidos: -">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Label fx:id="lblPromedioEspera" text="Espera promedio: -">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Label fx:id="lblPromedioAtencion" text="Atención promedio: -">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                        <TableView fx:id="tblAtendidos" VBox.vgrow="ALWAYS" />
                     </children>
                  </VBox>
               </content>
            </Tab>
            <Tab text="Por funcionario">
               <content>
                  <HBox spacing="15.0">
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="10.0" />
                     </padding>
                     <children>
                        <TableView fx:id="tblFuncionarios" prefWidth="380.0" />
                        <BarChart fx:id="chartFuncionarios" animated="false" legendVisible="false" title="Personas atendidas" HBox.hgrow="ALWAYS">
                           <xAxis>
                              <CategoryAxis />
                           </xAxis>
                           <yAxis>
                              <NumberAxis minorTickVisible="false" tickUnit="1.0" />
                           </yAxis>
                        </BarChart>
                     </children>
                  </HBox>
               </content>
            </Tab>
            <Tab text="Por servicio">
               <content>
                  <HBox spacing="15.0">
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="10.0" />
                     </padding>
                     <children>
                        <TableView fx:id="tblServicios" prefWidth="380.0" />
                        <BarChart fx:id="chartServicios" animated="false" legendVisible="false" title="Turnos por servicio" HBox.hgrow="ALWAYS">
                           <xAxis>
                              <CategoryAxis />
                           </xAxis>
                           <yAxis>
                              <NumberAxis minorTickVisible="false" tickUnit="1.0" />
                           </yAxis>
                        </BarChart>
                     </children>
                  </HBox>
               </content>
            </Tab>
         </tabs>
      </TabPane>
   </center>
</BorderPane>
